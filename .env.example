# Copy this file to .env and fill in your own values — see SETUP.md.
# .env is gitignored; never commit your real values.

# Anthropic API key used by reasoning_agent.py for player trend analysis
# (Sonnet + Haiku) and league executive summaries. Get one at
# https://console.anthropic.com/settings/keys
DASHBOARD_KEY=sk-ant-api03-your-key-here

# Parse Bot API key — powers contract_agent.py's Spotrac lookup and
# news_agent.py's ESPN/FantasyPros feeds. Optional: those steps just return
# no data and the pipeline continues without it.
PARSE_BOT_API=your-parse-bot-api-key

# Your Sleeper username (no auth required, just identifies whose leagues to fetch)
SLEEPER_USERNAME=your-sleeper-username

# Absolute path dashboard_agent.py writes index.html to (your nginx web root).
# Not required for --dry-run, which writes to /tmp instead.
DASHBOARD_OUTPUT_PATH=/var/www/vhosts/your-domain.com/httpdocs/dashboard/index.html
